<% content_for :title, "Check-in · #{@event.title}" %>
<%= link_to @event.title, event_path(@event), class: "back-link" %>
<div class="page-header">
  <div><p class="eyebrow">Door</p><h1>Check-in</h1><p class="page-header__meta"><%= event_when(@event) %></p></div>
</div>

<section class="stats" aria-label="Arrivals">
  <div class="stat stat--yes"><span class="stat__value"><%= @arrived %></span><span class="stat__label">Arrived</span></div>
  <div class="stat"><span class="stat__value"><%= @expected %></span><span class="stat__label">Expected (attending)</span></div>
</section>
<div class="meter mt-s" role="img" aria-label="<%= @arrived %> of <%= @expected %> arrived"><span class="meter__bar meter__bar--yes" data-width="<%= percent(@arrived, @expected) %>"></span></div>

<div class="panel mt-m">
  <%= form_with url: event_check_in_path(@event), method: :get, class: "toolbar" do |f| %>
    <div class="toolbar__search">
      <%= f.label :q, "Find a guest", class: "visually-hidden" %>
      <%= f.search_field :q, value: @query, placeholder: "Find a guest by name…", autofocus: true, autocomplete: "off" %>
    </div>
    <label class="checkbox small"><%= check_box_tag :all, "1", @show_all %> Include guests who didn't say yes</label>
    <%= f.submit "Search", class: "btn btn--small" %>
  <% end %>
  <p class="small muted">Guests with a QR pass: scan it with any phone camera to open their check-in page.</p>

  <% if @guests.empty? %>
    <p class="muted"><%= @query.present? ? "No guests match “#{@query}”." : "No attending guests yet." %></p>
  <% else %>
    <ul class="checkin-list">
      <%= render partial: "check_ins/guest_row", collection: @guests, as: :guest, locals: { event: @event, query: @query.presence } %>
    </ul>
  <% end %>
</div>
