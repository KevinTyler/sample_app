<% content_for :title, "Check in #{@guest.name}" %>
<div class="container--narrow">
  <%= link_to "Check-in list", event_check_in_path(@event), class: "back-link" %>
  <div class="panel">
    <p class="eyebrow"><%= @event.title %></p>
    <h1><%= @guest.name %></h1>
    <% unless @guest.rsvp_yes? || @guest.rsvp_maybe? %>
      <p class="badge badge--warning">RSVP: <%= RsvpHelper::STATUS_LABELS[@guest.rsvp_status] %></p>
    <% end %>
    <ul class="checkin-list mt-m">
      <%= render "check_ins/guest_row", guest: @guest, event: @event, query: nil %>
    </ul>
  </div>
</div>
