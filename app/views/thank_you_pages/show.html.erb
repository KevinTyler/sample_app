<% content_for :start_from, @event.share_token unless @preview || !@event.published? %>
<% content_for :title, gt("thank_you.for", name: @thank_you.first_name) %>
<% content_for :language_switch, "1" %>
<% design = InvitationDesign.for(@event) %>
<% content_for :head do %>
  <style nonce="<%= content_security_policy_nonce %>">.guest-body { --guest-backdrop: <%= design.valid? ? design.backdrop_css : "#ebdce1" %>; }</style>
<% end %>
<%= render "invitations/design_style", design: design, selector: "#thank-you-card" %>
<article id="thank-you-card" class="thank-card" data-heading-font="<%= design.heading_font %>" aria-label="Thank-you card">
  <p class="thank-card__to"><%= gt("thank_you.for", name: @thank_you.recipient_name) %></p>
  <h1 class="thank-card__title"><%= gt("thank_you.thank") %> <em><%= gt("thank_you.you") %></em></h1>
  <% if @thank_you.video? %>
    <video class="thank-card__media" src="<%= rails_storage_proxy_path(@thank_you.media) %>" controls playsinline preload="metadata" aria-label="<%= gt("thank_you.video_label") %>"></video>
  <% elsif @thank_you.image? %>
    <%= image_tag rails_storage_proxy_path(@thank_you.media), alt: (@thank_you.gift ? gt("thank_you.photo_alt_gift", gift: @thank_you.gift.description.downcase_first) : gt("thank_you.photo_alt")), class: "thank-card__media" %>
  <% end %>
  <% if @thank_you.gift %><p class="thank-card__gift"><%= gt("thank_you.for_gift_html", gift: tag.strong(@thank_you.gift.description.downcase_first)) %></p><% end %>
  <% if @thank_you.message.present? %><p class="thank-card__note handwritten"><%= @thank_you.message %></p><% end %>
  <% if @thank_you.signed.present? %><p class="thank-card__signed handwritten"><%= @thank_you.signed %></p><% end %>
</article>

<div class="thank-actions">
  <% if @thank_you.hearted_at %>
    <p class="badge badge--seen m-0"><%= gt("thank_you.hearted") %></p>
  <% else %>
    <%= button_to guest_heart_path_for(@thank_you), class: "btn btn--primary" do %><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7-4.4-7-10.2A4 4 0 0 1 12 8a4 4 0 0 1 7 2.8C19 16.6 12 21 12 21z"/></svg><%= gt("thank_you.heart") %><% end %>
  <% end %>
  <% if @thank_you.media.attached? %>
    <%= link_to (@thank_you.video? ? gt("thank_you.save_video") : gt("thank_you.save_photo")), rails_storage_proxy_path(@thank_you.media, disposition: "attachment"), class: "btn", data: { turbo: false } %>
  <% end %>
</div>
<p class="thank-from"><%= gt("thank_you.from", host: @event.display_host_name, title: @event.title) %></p>
