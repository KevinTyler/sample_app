<%# locals: (event:, calendar: nil, ics_path: nil, private_details: true) %>
<section class="guest-panel" aria-labelledby="details-heading">
  <h2 id="details-heading"><%= gt("details.title") %></h2>
  <dl class="details-list">
    <div>
      <dt><%= gt("details.when") %></dt>
      <dd>
        <%= event_when(event) %>
        <% if event.starts_at %>
          <span class="local-time" hidden data-controller="local-time" data-local-time-iso-value="<%= event.starts_at.iso8601 %>" data-local-time-zone-value="<%= event.time_zone %>" data-local-time-template-value="<%= gt("details.local_time", time: "%{time}") %>" data-local-time-locale-value="<%= I18n.locale %>"></span>
        <% end %>
      </dd>
    </div>
    <% if event.in_person? %>
      <div>
        <dt><%= gt("details.where") %></dt>
        <dd><%= event_where(event) %><% if (url = map_url(event)) %> · <%= link_to gt("details.map"), url, target: "_blank", rel: "noopener noreferrer" %><% end %></dd>
      </div>
    <% end %>
    <% if event.online? %>
      <div><dt><%= gt("details.join_online") %></dt><dd>
        <% if private_details %>
          <%= link_to event.video_url.truncate(60), event.video_url, target: "_blank", rel: "noopener noreferrer" %>
        <% else %>
          <%= gt("details.video_private") %>
        <% end %>
      </dd></div>
    <% end %>
    <div><dt><%= gt("details.host") %></dt><dd><%= event.display_host_name %></dd></div>
    <% if event.show_guest_count && (going = event.attending_count) > 0 %>
      <div><dt><%= gt("details.whos_coming") %></dt><dd><%= gt("details.guests_so_far", count: going) %></dd></div>
    <% end %>
    <% if event.description.present? %>
      <div><dt><%= gt("details.from_host") %></dt><dd><%= simple_format(event.description) %></dd></div>
    <% end %>
  </dl>
  <% if event.starts_at && !event.cancelled? && calendar %>
    <% invite = calendar %>
    <h3 class="mt-m"><%= gt("details.add_to_calendar") %></h3>
    <div class="calendar-links">
      <%= link_to "Apple / Outlook (.ics)", ics_path, class: "btn btn--small", data: { turbo: false } %>
      <%= link_to "Google Calendar", invite.google_url, class: "btn btn--small", target: "_blank", rel: "noopener noreferrer" %>
      <%= link_to "Outlook.com", invite.outlook_url, class: "btn btn--small", target: "_blank", rel: "noopener noreferrer" %>
    </div>
  <% end %>
</section>
