<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= title %></title>
    <%= render "layouts/head" %>
    <%= yield :head %>
  </head>

  <body data-controller="pwa">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="app-header">
      <div class="container app-header__inner">
        <%= link_to (authenticated? ? events_path : root_path), class: "brand", aria: { label: "Cordially — your events" } do %>
          <%= render "shared/brand_mark" %><span class="brand__name">Cordially</span>
        <% end %>
        <% if content_for?(:crumb) %>
          <span class="crumb-sep" aria-hidden="true">/</span>
          <%= yield :crumb %>
        <% end %>
        <nav class="app-nav" aria-label="Main">
          <% if authenticated? %>
            <%= nav_link "Events", events_path, active: controller_name == "events" && action_name == "index" %>
            <%= link_to new_event_path, class: "btn btn--wax btn--small" do %><%= icon(:plus, size: 16) %>New event<% end %>
            <details class="menu">
              <summary class="icon-button" aria-label="Account menu"><span class="avatar"><%= initials(current_user.name) %></span></summary>
              <div class="menu__panel">
                <div>
                  <strong><%= current_user.name %></strong>
                  <div class="small faint"><%= current_user.email_address %></div>
                </div>
                <%= link_to "Settings", edit_account_path, class: "btn btn--small btn--block" %>
                <%= button_to "Sign out", session_path, method: :delete, class: "btn btn--small btn--block btn--ghost" %>
              </div>
            </details>
          <% else %>
            <%= nav_link "Sign in", new_session_path %>
            <%= link_to "Get started", new_registration_path, class: "btn btn--primary btn--small" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main id="main" class="app-main">
      <div class="container <%= content_for(:container_class) %>">
        <% if flash.any? %><div class="flash-area"><%= flash_messages %></div><% end %>
        <%= content_for?(:workspace) ? yield(:workspace) : yield %>
      </div>
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <span>Cordially — invitations, replies and the door, beautifully handled.</span>
        <span><%= link_to "About", about_path %> · <%= link_to "Contact", contact_path %><% if Messaging.outbox_enabled? %> · <%= link_to "Dev outbox", dev_outbox_index_path %><% end %></span>
      </div>
    </footer>
  </body>
</html>
