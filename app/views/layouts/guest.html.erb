<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || gt("layout.default_title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#15132b">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="same-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>
  <body class="guest-body <%= content_for(:body_class) %>">
    <main class="guest-shell" id="main">
      <% if flash.any? %><div class="flash-area"><%= flash_messages %></div><% end %>
      <%= yield %>
      <footer class="guest-footer">
        <%= yield :guest_footer %>
        <%= link_to (content_for?(:start_from) ? start_path(from: content_for(:start_from).strip) : root_path), class: "host-cta" do %>
          <%= render "shared/brand_mark" %>
          <span><strong><%= gt("layout.host_cta_title") %></strong><span class="small muted"><%= gt("layout.host_cta_body") %></span></span>
        <% end %>
        <% if content_for?(:language_switch) %>
          <nav class="lang-switch" aria-label="<%= gt("layout.language") %>">
            <% Event::LOCALES.each do |code, name| %>
              <%= link_to name, url_for(lang: code), lang: code, hreflang: code, class: ("is-active" if I18n.locale.to_s == code), aria: { current: (I18n.locale.to_s == code ? "true" : nil) } %>
            <% end %>
          </nav>
        <% end %>
      </footer>
    </main>
  </body>
</html>
