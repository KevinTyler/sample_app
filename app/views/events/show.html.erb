<% content_for :title, @event.title %>
<% design = InvitationDesign.for(@event) %>
<header class="page-header">
  <div>
    <div class="cluster mb-s"><%= event_status_badge(@event) %><% if policy.role != "owner" %><span class="tag"><%= EventsHelper::ROLE_LABELS[policy.role] %></span><% end %></div>
    <h1><%= @event.title %></h1>
    <p class="page-header__meta">
      <span class="cluster"><%= icon(:calendar, size: 16) %><%= event_when(@event) %></span>
      <% if (place = event_where(@event)) %><span class="cluster"><%= icon(:pin, size: 16) %><%= place %></span><% end %>
    </p>
  </div>
  <div class="page-header__actions">
    <%= link_to preview_event_path(@event), class: "btn", target: "_blank", rel: "noopener" do %><%= icon(:eye, size: 18) %>Preview as guest<% end %>
    <%= link_to "Print", print_event_path(@event), class: "btn btn--ghost" %>
    <% if @event.draft? && policy.can?(:publish) %>
      <%= button_to "Publish", publish_event_path(@event), class: "btn btn--wax" %>
    <% end %>
  </div>
</header>

<% if @event.draft? %>
  <div class="panel panel--warning callout" role="note">
    <div class="callout__icon">!</div>
    <div>
      <strong>This event is a draft.</strong>
      <p class="small m-0">Guests can't open invitations until you publish. Add guests and questions now; send once it's published.</p>
    </div>
  </div>
<% elsif @event.cancelled? %>
  <div class="panel panel--danger" role="note">
    <strong>This event was cancelled<% if @event.cancelled_at %> on <%= @event.local(@event.cancelled_at).strftime("%B %-d, %Y") %><% end %>.</strong>
    <% if @event.cancellation_note.present? %><p class="small mt-xs m-0"><%= @event.cancellation_note %></p><% end %>
  </div>
<% end %>

<div class="grid grid--2">
  <section class="preview-stage" aria-label="Invitation preview">
    <div class="preview-stage__actions">
      <% if policy.can?(:edit) %><%= link_to "Edit design", edit_event_design_path(@event), class: "btn btn--small" %><% end %>
    </div>
    <%= render "invitations/card", event: @event, design: design, card_id: "dashboard-card" %>
    <div class="preview-stage__envelope" id="dashboard-envelope" aria-hidden="true"></div>
    <style nonce="<%= content_security_policy_nonce %>">
      #dashboard-envelope { background: color-mix(in srgb, <%= design.valid? ? design.accent_color : "#8e2b4f" %> 78%, #15132b); }
      .preview-stage { background: color-mix(in srgb, <%= design.valid? ? design.accent_color : "#8e2b4f" %> 14%, #f6f1e9); }
    </style>
  </section>

  <section class="panel" aria-labelledby="replies-heading">
    <div class="panel__header">
      <h2 id="replies-heading" class="panel__title">Replies</h2>
      <% if policy.can?(:manage_guests) %><%= link_to "Guest list", event_guests_path(@event), class: "btn btn--small btn--ghost" %><% end %>
    </div>
    <div class="reply-hero">
      <span class="reply-hero__number"><%= @summary[:attending] %></span>
      <span class="reply-hero__label">
        <strong><%= @summary[:attending] == 1 ? "person attending" : "people attending" %></strong>
        <% if @event.track_kids? && @summary[:attending] > 0 %><span class="small"><%= pluralize(@summary[:attending] - @summary[:attending_kids], "adult") %> · <%= pluralize(@summary[:attending_kids], "kid") %></span><% end %>
        <span class="muted small"><%= pluralize(@summary[:invited], "guest") %> on the list<% if @event.capacity %> · <%= @event.spots_remaining %> of <%= @event.capacity %> spots left<% end %></span>
      </span>
    </div>
    <% if @summary[:invited] > 0 %>
      <div class="meter mt-m" role="img" aria-label="<%= @summary[:yes] %> yes, <%= @summary[:maybe] %> maybe, <%= @summary[:no] %> no of <%= @summary[:invited] %>">
        <span class="meter__bar meter__bar--yes" data-width="<%= percent(@summary[:yes], @summary[:invited]) %>"></span>
        <span class="meter__bar meter__bar--maybe" data-width="<%= percent(@summary[:maybe], @summary[:invited]) %>"></span>
        <span class="meter__bar meter__bar--no" data-width="<%= percent(@summary[:no], @summary[:invited]) %>"></span>
      </div>
    <% end %>
    <div class="stat-row mt-m" aria-label="RSVP summary">
      <div class="stat stat--yes"><span class="stat__value"><%= @summary[:yes] %></span><span class="stat__label">Yes</span></div>
      <% if @event.allow_maybe || @summary[:maybe] > 0 %>
        <div class="stat stat--maybe"><span class="stat__value"><%= @summary[:maybe] %></span><span class="stat__label">Maybe</span></div>
      <% end %>
      <div class="stat stat--no"><span class="stat__value"><%= @summary[:no] %></span><span class="stat__label">No</span></div>
      <div class="stat"><span class="stat__value"><%= @summary[:pending] %></span><span class="stat__label">Awaiting</span></div>
    </div>
    <p class="small muted mt-m m-0">
      <%= @summary[:sent] %> invited · <%= @summary[:viewed] %> opened
      <% if @summary[:maybe_headcount] > 0 %> · <%= @summary[:maybe_headcount] %> more might come<% end %>
      <% if @event.rsvp_deadline %> · replies close <%= @event.local(@event.rsvp_deadline).strftime("%b %-d") %><% end %>
    </p>
    <% if @event.ticketed? %>
      <p class="small mt-xs m-0"><strong><%= Money.format(@event.collected_cents, @event.currency) %></strong> collected · <%= Money.format(@event.ticket_price_cents, @event.currency) %> per person</p>
    <% end %>
    <% if (items = @event.schedule_items.select(&:collects_replies)).any? %>
      <h3 class="mt-m small faint">By part of the event</h3>
      <ul class="tally">
        <% items.each do |item| %>
          <% invited = item.guests.count %>
          <li><span><%= item.name %></span><strong><%= item.headcount %></strong><span class="tally__bar"><span class="tally__fill" data-width="<%= percent(item.headcount, [ invited, @summary[:attending] ].max) %>"></span></span></li>
        <% end %>
      </ul>
    <% end %>
    <% if (choice = @questions.find(&:choice?)) %>
      <% tally = choice.rsvp_answers.group(:value).count %>
      <% total = tally.values.sum %>
      <% if total > 0 %>
        <h3 class="mt-m small faint"><%= choice.prompt %></h3>
        <ul class="tally">
          <% choice.options.each do |option| %>
            <li><span><%= option %></span><strong><%= tally.fetch(option, 0) %></strong><span class="tally__bar"><span class="tally__fill" data-width="<%= percent(tally.fetch(option, 0), total) %>"></span></span></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  </section>
</div>

<div class="grid grid--2 grid--top">
  <% if @event.published? && policy.can?(:send_messages) && @uninvited_count > 0 %>
    <section class="panel panel--accent" aria-labelledby="send-heading">
      <div class="panel__header"><h2 id="send-heading" class="panel__title">Send <%= @event.invitation? ? "invitations" : @event.card_type_name.downcase.pluralize %></h2></div>
      <%= form_with url: event_invitation_send_path(@event), method: :post, class: "form" do |f| %>
        <%= f.hidden_field :idempotency_key, value: SecureRandom.uuid %>
        <p class="small m-0"><strong><%= pluralize(@uninvited_count, "guest") %></strong> <%= @uninvited_count == 1 ? "hasn't" : "haven't" %> been invited yet. Each gets a personal link to reply — guests already invited won't get a second copy.</p>
        <div class="field">
          <%= f.label :personal_note do %>Personal note <span class="field__optional">(optional, appears in the email)</span><% end %>
          <%= f.text_area :personal_note, rows: 3, maxlength: 1000, placeholder: "Can't wait to celebrate with you!" %>
        </div>
        <% if Messaging.enabled_channels.size > 1 %>
          <div class="cluster">
            <label class="checkbox"><%= check_box_tag "channels[]", "email", true, id: "invite_channel_email" %> Email</label>
            <% if Messaging.sms_enabled? %><label class="checkbox"><%= check_box_tag "channels[]", "sms", false, id: "invite_channel_sms" %> Text message</label><% end %>
            <% if Messaging.whatsapp_enabled? %><label class="checkbox"><%= check_box_tag "channels[]", "whatsapp", false, id: "invite_channel_whatsapp" %> WhatsApp</label><% end %>
          </div>
          <p class="field__hint m-0">Texts and WhatsApp go to guests with a mobile number.</p>
        <% end %>
        <fieldset class="send-when" data-controller="schedule-toggle">
          <legend class="field__label">When</legend>
          <div class="cluster">
            <label class="checkbox"><%= radio_button_tag :send_at, "now", true, data: { action: "schedule-toggle#update" } %> Now</label>
            <label class="checkbox"><%= radio_button_tag :send_at, "later", false, data: { action: "schedule-toggle#update" } %> Later</label>
          </div>
          <div class="field mt-s" data-schedule-toggle-target="when" hidden>
            <%= label_tag :scheduled_for_local, "Send on (#{@event.zone.tzinfo.abbreviation})" %>
            <%= datetime_local_field_tag :scheduled_for_local, nil, min: Time.current.in_time_zone(@event.zone).strftime("%Y-%m-%dT%H:%M") %>
            <p class="field__hint">Everyone not yet invited at that moment gets their invitation, including guests you add before then.</p>
          </div>
        </fieldset>
        <div class="form-actions"><%= f.submit Messaging.enabled_channels.size > 1 ? "Send" : "Send #{pluralize(@uninvited_count, @event.invitation? ? 'invitation' : @event.card_type_name.downcase)}", class: "btn btn--wax", data: { turbo_submits_with: "Sending…" } %></div>
      <% end %>
    </section>
  <% elsif policy.can?(:edit) %>
    <% steps = [
         [ "Make the invitation yours", @event.design_settings.present? || @event.artwork.attached?, edit_event_design_path(@event) ],
         [ "Add your guests", @summary[:invited] > 0, (policy.can?(:manage_guests) ? event_guests_path(@event) : nil) ],
         ([ "Ask what you need to know", @questions.any?, event_questions_path(@event) ] if @event.collects_replies?),
         [ "Publish", !@event.draft?, nil ],
         [ "Send #{@event.invitation? ? 'the invitations' : @event.card_type_name.downcase.pluralize}", @summary[:sent] > 0, nil ]
       ].compact %>
    <section class="panel" aria-labelledby="ready-heading">
      <div class="panel__header">
        <h2 id="ready-heading" class="panel__title">Getting ready</h2>
        <span class="small faint"><%= steps.count { |s| s[1] } %> of <%= steps.size %> done</span>
      </div>
      <ol class="checklist">
        <% steps.each do |label, done, path| %>
          <li class="<%= 'is-done' if done %>">
            <span class="checklist__mark"><% if done %><%= icon(:check, size: 14) %><% end %></span>
            <% if path && !done %><%= link_to label, path %><% else %><span><%= label %></span><% end %>
            <% if done %><span class="visually-hidden">(done)</span><% end %>
          </li>
        <% end %>
      </ol>
    </section>
  <% end %>

  <% if policy.can?(:send_messages) && !@event.draft? %>
    <section class="panel" aria-labelledby="reminders-heading">
      <div class="panel__header">
        <h2 id="reminders-heading" class="panel__title">Reminders &amp; updates</h2>
        <%= link_to "All messages", event_messages_path(@event), class: "btn btn--small btn--ghost" %>
      </div>
      <% scheduled = @event.messages.where(status: "scheduled").order(:scheduled_for).limit(3) %>
      <% if scheduled.any? %>
        <ul class="activity mb-s">
          <% scheduled.each do |message| %>
            <% at = @event.local(message.scheduled_for) %>
            <li class="automation">
              <span class="date-chip"><%= at.strftime("%b") %><strong><%= at.day %></strong></span>
              <span class="activity__text"><%= link_to message.subject_line, event_message_path(@event, message) %><time><%= MessagesHelper::KIND_LABELS[message.kind] %> · <%= short_time(at) %></time></span>
            </li>
          <% end %>
        </ul>
      <% end %>
      <div class="cluster">
        <%= link_to "Send an update", new_event_message_path(@event), class: "btn btn--small btn--primary" %>
        <% if @summary[:pending] > 0 %><%= link_to "Nudge #{@summary[:pending]} awaiting", new_event_message_path(@event, preset: "nudge"), class: "btn btn--small" %><% end %>
        <% if @event.starts_at && @event.starts_at > 1.day.from_now %><%= link_to "Day-before reminder", new_event_message_path(@event, preset: "day_before"), class: "btn btn--small" %><% end %>
      </div>
      <% if @recent_messages.any? %>
        <ul class="activity mt-m">
          <% @recent_messages.each do |message| %>
            <li><span class="activity__text"><%= link_to "#{MessagesHelper::KIND_LABELS[message.kind]}: #{message.subject_line}", event_message_path(@event, message) %><time><%= message_status_text(message) %></time></span></li>
          <% end %>
        </ul>
      <% end %>
    </section>
  <% end %>

  <section class="panel" aria-labelledby="activity-heading">
    <div class="panel__header"><h2 id="activity-heading" class="panel__title">Just now</h2></div>
    <% if @activities.empty? %>
      <p class="small muted m-0">Replies, opens and check-ins will appear here as they happen.</p>
    <% else %>
      <ul class="activity">
        <% @activities.each do |activity| %>
          <% mood = { "yes" => "yes", "no" => "no", "maybe" => "maybe" }[activity.data&.dig("to")] || (activity.action == "viewed" ? "seen" : nil) %>
          <li>
            <span class="monogram monogram--small <%= "monogram--#{mood}" if mood %>" aria-hidden="true"><%= initials(activity.actor_name) %></span>
            <span class="activity__text"><span><%= activity_sentence(activity) %></span><time datetime="<%= activity.created_at.iso8601 %>"><%= time_ago_in_words(activity.created_at) %> ago</time></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <% if @event.guestbook_enabled? && (entries = @event.guestbook_entries.recent.limit(6)).any? %>
    <section class="panel" id="guestbook" aria-labelledby="guestbook-heading">
      <div class="panel__header"><h2 id="guestbook-heading" class="panel__title">Guestbook</h2></div>
      <ul class="guestbook">
        <% entries.each do |entry| %>
          <li class="<%= 'is-hidden' if entry.hidden? %>">
            <span class="monogram monogram--small" aria-hidden="true"><%= initials(entry.author_name) %></span>
            <div class="guestbook__text">
              <strong><%= entry.author_name %></strong> <span class="faint small"><%= time_ago_in_words(entry.created_at) %> ago<%= " · hidden from guests" if entry.hidden? %></span>
              <p class="pre-line"><%= entry.body %></p>
            </div>
            <% if policy.can?(:edit) %>
              <%= button_to (entry.hidden? ? "Show" : "Hide"), event_guestbook_entry_path(@event, entry), method: :patch, params: { hidden: entry.hidden? ? "0" : "1" }, class: "btn btn--small btn--ghost" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
