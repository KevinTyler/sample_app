<% content_for :title, "Your events" %>
<header class="page-header mb-s">
  <div>
    <span class="eyebrow">Hello, <%= current_user.first_name %></span>
    <h1>Your <em>events</em></h1>
  </div>
  <div class="page-header__actions">
    <%= link_to new_event_path, class: "btn btn--wax" do %><%= icon(:plus, size: 18) %>New event<% end %>
  </div>
</header>

<% if @upcoming.empty? && @past.empty? && @cancelled.empty? %>
  <div class="empty-state mt-m">
    <%= render "shared/brand_mark", css_class: "auth-card__seal" %>
    <h2>Your first invitation awaits</h2>
    <p class="muted">Pick a design, add your guests and send — replies arrive here as they happen.</p>
    <%= link_to "Plan your first event", new_event_path, class: "btn btn--primary" %>
  </div>
<% else %>
  <% [ [ "Upcoming & drafts", @upcoming, true ], [ "Past", @past, false ], [ "Cancelled", @cancelled, false ] ].each do |heading, events, with_new| %>
    <% next if events.empty? && !with_new %>
    <section class="stack-s mt-l" aria-label="<%= heading %>">
      <h2 class="eyebrow"><%= heading %></h2>
      <div class="event-grid">
        <%= render partial: "events/event_card", collection: events, as: :event %>
        <% if with_new %>
          <%= link_to new_event_path, class: "event-card event-card--new" do %>
            <span class="event-card__plus"><%= icon(:plus, size: 26) %></span>
            <strong>Plan something new</strong>
            <span class="small">Birthdays, weddings, dinners, launches</span>
          <% end %>
          <% if assistant_available? %>
            <div class="event-card event-card--new event-card--text">
              <span class="event-card__plus"><%= icon(:chat, size: 24) %></span>
              <strong>Or make one by text</strong>
              <span class="small">Text the assistant what you're planning.</span>
              <div class="cluster"><% assistant_links.each do |label, href| %><%= link_to label, href, class: "btn btn--small" %><% end %></div>
            </div>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>
