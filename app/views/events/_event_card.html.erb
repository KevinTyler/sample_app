<% design = InvitationDesign.for(event) %>
<%= link_to event_path(event), class: "event-card" do %>
  <%= render "invitations/design_style", design: design, selector: "#event-swatch-#{event.id}" %>
  <div class="event-card__swatch invite-card" id="event-swatch-<%= event.id %>" aria-hidden="true">
    <% if design.artwork && lookup_context.exists?(design.artwork, [ "invitation_artworks" ], true) %>
      <div class="invite-art"><%= render "invitation_artworks/#{design.artwork}" %></div>
    <% end %>
  </div>
  <div class="event-card__body">
    <div class="cluster"><%= event_status_badge(event) %></div>
    <h3 class="event-card__title"><%= event.title %></h3>
    <p class="event-card__meta"><%= event_date_short(event) %><% if (place = event_where(event)) %> · <%= place %><% end %></p>
    <div class="event-card__footer">
      <% yes = event.guests.where(rsvp_status: "yes").sum(:party_size) %>
      <span><%= pluralize(event.guests.count, "guest") %></span>
      <span><%= yes %> attending</span>
    </div>
  </div>
<% end %>
