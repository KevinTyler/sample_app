<% content_for :title, "Reset your password" %>
<div class="auth-shell">
<div class="auth-card">
  <%= render "shared/brand_mark", css_class: "auth-card__seal" %>
  <h1>Forgot your password?</h1>
  <%= form_with url: passwords_path, class: "form" do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </div>
    <div class="form-actions"><%= form.submit "Email reset instructions", class: "btn btn--primary btn--block" %></div>
  <% end %>
</div>
</div>
