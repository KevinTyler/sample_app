<% content_for :title, "Design · #{@event.title}" %>
<% content_for :full_bleed, "1" %>
<header class="page-header mb-s">
  <div>
    <span class="eyebrow"><%= @event.draft? ? "Step 2 of 3 · Design" : "Design" %></span>
    <h1>Make it <em>yours</em></h1>
    <p class="page-header__meta">Changes preview instantly. Guests see the saved version.</p>
  </div>
  <div class="page-header__actions">
    <%= link_to preview_event_path(@event), class: "btn", target: "_blank", rel: "noopener" do %><%= icon(:eye, size: 18) %>Preview as guest<% end %>
  </div>
</header>

<%= form_with url: event_design_path(@event), method: :patch, multipart: true, class: "studio mt-m",
      data: { controller: "design-editor tabs", design_editor_templates_value: design_editor_templates_json, design_editor_fonts_value: design_editor_fonts_json } do |f| %>
  <div class="studio__tools">
    <div class="studio__rail" role="tablist" aria-label="Design tools" aria-orientation="vertical">
      <button type="button" class="studio__tab" role="tab" id="studio-tab-templates" aria-controls="studio-templates" aria-selected="true" tabindex="0" data-tabs-target="tab" data-action="tabs#select keydown->tabs#keydown"><%= icon(:overview, size: 22) %>Templates</button>
      <button type="button" class="studio__tab" role="tab" id="studio-tab-words" aria-controls="studio-words" aria-selected="false" tabindex="-1" data-tabs-target="tab" data-action="tabs#select keydown->tabs#keydown"><%= icon(:type, size: 22) %>Words</button>
      <button type="button" class="studio__tab" role="tab" id="studio-tab-style" aria-controls="studio-style" aria-selected="false" tabindex="-1" data-tabs-target="tab" data-action="tabs#select keydown->tabs#keydown"><%= icon(:palette, size: 22) %>Style</button>
      <button type="button" class="studio__tab" role="tab" id="studio-tab-photo" aria-controls="studio-photo" aria-selected="false" tabindex="-1" data-tabs-target="tab" data-action="tabs#select keydown->tabs#keydown"><%= icon(:image, size: 22) %>Photo</button>
    </div>
    <div class="studio__body">
      <%= form_errors(@event) %>
      <section class="studio__panel" role="tabpanel" id="studio-templates" aria-labelledby="studio-tab-templates" data-tabs-target="panel">
        <h2 class="studio__heading">Start from a design</h2>

      <div class="template-picker" role="radiogroup" aria-label="Templates">
        <% InvitationTemplate.all.each do |template| %>
          <label class="template-option">
            <%= radio_button_tag "design[template]", template.key, @design.template == template.key, class: "visually-hidden", data: { action: "design-editor#chooseTemplate" } %>
            <span class="template-option__card">
              <%= render "invitations/card", event: @event, design: InvitationDesign.new(template.design_defaults), card_id: "pick-#{template.key}", show_details: false, title_tag: :p %>
            </span>
            <span class="template-option__name"><%= template.name %></span>
          </label>
        <% end %>
      </div>
      </section>
      <section class="studio__panel" role="tabpanel" id="studio-words" aria-labelledby="studio-tab-words" data-tabs-target="panel" hidden>
        <h2 class="studio__heading">Words on the card</h2>

      <div class="field">
        <label for="design_tagline">Small line above <span class="field__optional">(optional)</span></label>
        <%= text_field_tag "design[tagline]", @design.tagline, id: "design_tagline", maxlength: InvitationDesign::TEXT_LIMITS[:tagline], data: { action: "input->design-editor#refresh" } %>
      </div>
      <div class="field">
        <label for="design_headline">Headline <span class="field__optional">(optional)</span></label>
        <%= text_field_tag "design[headline]", @design.headline, id: "design_headline", maxlength: InvitationDesign::TEXT_LIMITS[:headline], data: { action: "input->design-editor#refresh" } %>
        <p class="field__hint">The event name, date and place come from your event details.</p>
      </div>
      <div class="field">
        <label for="design_message">Message on the card <span class="field__optional">(optional)</span></label>
        <%= text_area_tag "design[message]", @design.message, id: "design_message", rows: 3, maxlength: InvitationDesign::TEXT_LIMITS[:message], data: { action: "input->design-editor#refresh" } %>
      </div>
      </section>
      <section class="studio__panel" role="tabpanel" id="studio-style" aria-labelledby="studio-tab-style" data-tabs-target="panel" hidden>
        <h2 class="studio__heading">Fonts, colors &amp; layout</h2>
        <h3 class="studio__subheading">Fonts</h3>

      <div class="form-row form-row--2">
        <div class="field">
          <label for="design_heading_font">Headings</label>
          <%= select_tag "design[heading_font]", font_options(@design.heading_font), id: "design_heading_font", data: { action: "design-editor#refresh" } %>
        </div>
        <div class="field">
          <label for="design_body_font">Details</label>
          <%= select_tag "design[body_font]", font_options(@design.body_font), id: "design_body_font", data: { action: "design-editor#refresh" } %>
        </div>
      </div>
        <h3 class="studio__subheading">Colors</h3>

      <div class="color-inputs">
        <% { "background_color" => "Background", "text_color" => "Text", "accent_color" => "Accent" }.each do |attr, label| %>
          <div class="field">
            <label for="design_<%= attr %>"><%= label %></label>
            <%= color_field_tag "design[#{attr}]", @design.public_send(attr), id: "design_#{attr}", data: { action: "input->design-editor#refresh" } %>
          </div>
        <% end %>
      </div>
      <p class="field__hint" data-design-editor-target="contrast" hidden>Text and background are hard to tell apart — guests may struggle to read this.</p>
      <div>
        <p class="field__label small">Suggested palettes</p>
        <div class="palette-row">
          <% DesignsHelper::PALETTES.each do |palette| %>
            <button type="button" class="palette-button" title="<%= palette[:name] %>" aria-label="Use the <%= palette[:name] %> palette"
              data-action="design-editor#applyPalette" data-bg="<%= palette[:bg] %>" data-ink="<%= palette[:ink] %>" data-accent="<%= palette[:accent] %>">
              <%= palette_swatch(palette) %>
            </button>
          <% end %>
        </div>
      </div>
        <h3 class="studio__subheading">Layout</h3>

      <div class="layout-options" role="radiogroup" aria-label="Layout">
        <% InvitationDesign::LAYOUTS.each do |key, label| %>
          <label class="layout-option">
            <%= radio_button_tag "design[layout]", key, @design.layout == key, class: "visually-hidden", data: { action: "design-editor#refresh" } %>
            <span class="layout-option__box"><%= layout_diagram(key) %><span><%= label %></span></span>
          </label>
        <% end %>
      </div>
      <label class="checkbox">
        <%= hidden_field_tag "design[show_artwork]", "0", id: nil %>
        <%= check_box_tag "design[show_artwork]", "1", @design.show_artwork, data: { action: "design-editor#refresh" } %>
        Show the template's artwork
      </label>
      </section>
      <section class="studio__panel" role="tabpanel" id="studio-photo" aria-labelledby="studio-tab-photo" data-tabs-target="panel" hidden>
        <h2 class="studio__heading">Your photo or artwork</h2>

      <p class="field__hint">Upload a photo or your own artwork (PNG, JPEG, WebP or GIF, up to 8 MB). Tip: choose “Plain Paper” and “Full background” to use your own full-card design.</p>
      <% if @event.artwork.attached? && @event.artwork.persisted? %>
        <div class="current-artwork"><%= image_tag url_for(@event.artwork), alt: "Current artwork" %>
          <label class="checkbox"><%= check_box_tag :remove_artwork, "1", false %> Remove this image</label>
        </div>
      <% end %>
      <div class="field">
        <label for="artwork">Upload image</label>
        <%= file_field_tag :artwork, accept: Event::ARTWORK_TYPES.join(","), data: { action: "design-editor#previewPhoto" } %>
      </div>
      <div class="field">
        <label for="design_photo_style">Placement</label>
        <%= select_tag "design[photo_style]", options_for_select(InvitationDesign::PHOTO_STYLES.invert, @design.photo_style), id: "design_photo_style", data: { action: "design-editor#refresh" } %>
      </div>
      </section>
      <div class="studio__savebar">
        <%= f.submit "Save design", class: "btn btn--wax" %>
        <%= link_to "Done", event_path(@event), class: "btn btn--ghost" %>
      </div>
    </div>
  </div>

  <div class="studio__stage">
    <div class="segmented" role="group" aria-label="Preview size">
      <button type="button" class="segmented__item" aria-pressed="true" data-viewport="desktop" data-action="design-editor#setViewport" data-design-editor-target="viewportButton">Desktop</button>
      <button type="button" class="segmented__item" aria-pressed="false" data-viewport="mobile" data-action="design-editor#setViewport" data-design-editor-target="viewportButton">Phone</button>
    </div>
    <div class="preview-frame" data-viewport="desktop" data-design-editor-target="frame">
      <div class="preview-frame__screen">
        <%= render "invitations/card", event: @event, design: @design, card_id: "editor-card", editor: true %>
        <div class="preview-rsvp" aria-hidden="true">
          <strong>Will you be there?</strong>
          <span class="preview-rsvp__choices"><span>Yes</span><span>Maybe</span><span>No</span></span>
        </div>
      </div>
    </div>
  </div>
<% end %>

<% InvitationTemplate.all.filter_map(&:artwork).uniq.each do |artwork| %>
  <template data-artwork-template="<%= artwork %>"><%= render "invitation_artworks/#{artwork}" %></template>
<% end %>
