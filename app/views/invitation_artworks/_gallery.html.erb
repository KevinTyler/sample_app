<%# Gallery — a quiet, modern composition: a ruled margin, an orbit and a grid of dots. %>
<svg viewBox="0 0 500 700" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
  <line class="art-line-ink" stroke-width="1.5" x1="42" y1="40" x2="42" y2="660"/>
  <line class="art-line-ink" stroke-width="1.5" x1="42" y1="112" x2="190" y2="112"/>
  <circle class="art-line" stroke-width="2" cx="372" cy="196" r="118"/>
  <circle class="art-line" stroke-width="1" opacity="0.5" cx="372" cy="196" r="150"/>
  <circle class="art-accent" cx="372" cy="196" r="30"/>
  <circle class="art-accent" cx="465" cy="138" r="7"/>
  <% 5.times do |row| %>
    <% 5.times do |col| %>
      <circle class="art-ink-soft" cx="<%= 76 + col * 16 %>" cy="<%= 150 + row * 16 %>" r="2.4"/>
    <% end %>
  <% end %>
  <rect class="art-soft" x="400" y="600" width="58" height="58"/>
</svg>
