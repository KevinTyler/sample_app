<% bg = @design.background_color; ink = @design.text_color; accent = @design.accent_color; host = @event.display_host_name %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F6F1E9;padding:24px 12px;">
  <tr>
    <td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#FFFFFF;border-radius:14px;overflow:hidden;">
        <tr>
          <td style="background:<%= bg %>;color:<%= ink %>;padding:40px 32px;text-align:center;border-bottom:6px solid <%= accent %>;">
            <% if @message.kind == "invitation" %>
              <p style="margin:0 0 8px;font-size:13px;letter-spacing:2px;text-transform:uppercase;color:<%= accent %>;"><%= t("guest.mail.invited_you", host: host) %></p>
            <% else %>
              <p style="margin:0 0 8px;font-size:13px;letter-spacing:2px;text-transform:uppercase;color:<%= accent %>;"><%= t("guest.mail.label_#{@message.kind}", host: host, default: "") %></p>
            <% end %>
            <h1 style="margin:0;font-family:Georgia,'Times New Roman',serif;font-size:30px;line-height:1.2;font-weight:normal;"><%= @event.title %></h1>
            <% if @event.starts_at %>
              <p style="margin:16px 0 0;font-size:16px;"><%= event_when(@event) %></p>
            <% end %>
            <% if (place = event_where(@event)).present? %>
              <p style="margin:6px 0 0;font-size:15px;opacity:0.85;"><%= place %></p>
            <% end %>
          </td>
        </tr>
        <tr>
          <td style="padding:28px 32px;font-size:16px;line-height:1.55;color:#1C1A2E;">
            <p style="margin:0 0 16px;"><%= t("guest.mail.hi", name: @guest.first_name) %></p>
            <% if @message.body.present? %>
              <div style="margin:0 0 20px;white-space:pre-line;"><%= @message.body %></div>
            <% elsif @message.kind.in?(%w[invitation save_the_date announcement cancellation]) %>
              <p style="margin:0 0 20px;"><%= t("guest.mail.body_#{@message.kind}", host: host) %></p>
            <% end %>
            <% unless @event.cancelled? %>
              <table role="presentation" cellpadding="0" cellspacing="0" style="margin:8px 0 20px;">
                <tr>
                  <td style="border-radius:999px;background:#15132B;">
                    <a href="<%= @url %>" style="display:inline-block;padding:14px 28px;color:#FFFFFF;text-decoration:none;font-weight:bold;font-size:16px;border-radius:999px;background:#15132B;">
                      <%= t("guest.mail.button_#{{ "invitation" => "invitation", "save_the_date" => "save_the_date", "rsvp_confirmation" => "rsvp_confirmation" }.fetch(@message.kind, @event.collects_replies? && @message.kind != "announcement" ? "view" : "open")}") %>
                    </a>
                  </td>
                </tr>
              </table>
            <% end %>
            <p style="margin:0;font-size:13px;color:#6F6B82;"><%= t("guest.mail.personal") %><% if @event.collects_replies? %> <%= t("guest.mail.change_later") %><% end %></p>
          </td>
        </tr>
        <tr>
          <td style="padding:18px 32px;background:#FFFDF9;font-size:12px;color:#6F6B82;line-height:1.5;">
            <%= t("guest.mail.sent_on_behalf", host: host) %><br>
            <a href="<%= @url %>" style="color:#6F6B82;"><%= t("guest.mail.manage") %></a> ·
            <%= t("guest.mail.stop_hint") %>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
