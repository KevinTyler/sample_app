<% host = @event.display_host_name -%>
<% if @message.kind == "invitation" -%>
<%= t("guest.sms.invitation", host: host, title: @event.title) %>
<% elsif @message.kind == "save_the_date" -%>
<%= t("guest.sms.save_the_date", host: host, title: @event.title) %>
<% else -%>
<%= @message.subject_line %>
<% end -%>

<% if @event.starts_at -%>
<%= t("guest.mail.when") %> <%= event_when(@event) %>
<% end -%>
<% if (place = event_where(@event)).present? -%>
<%= t("guest.mail.where") %> <%= place %>
<% end -%>

<%= t("guest.mail.hi", name: @guest.first_name) %>

<% if @message.body.present? -%>
<%= @message.body %>
<% elsif @message.kind.in?(%w[invitation save_the_date announcement cancellation]) -%>
<%= t("guest.mail.body_#{@message.kind}", host: host) %>
<% end -%>

<%= t("guest.mail.your_invitation") %> <%= @url %>
(<%= t("guest.mail.personal") %><% if @event.collects_replies? %> <%= t("guest.mail.change_later") %><% end %>)

--
<%= t("guest.mail.sent_on_behalf", host: host) %>
<%= t("guest.mail.stop") %>
<%= @url %>
