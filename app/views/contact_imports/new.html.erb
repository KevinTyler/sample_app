<% content_for :title, "Bring your people" %>
<div class="container--wide">
  <%= link_to "Contacts", contacts_path, class: "back-link" %>
  <header class="page-header mb-s">
    <div>
      <span class="eyebrow">Import</span>
      <h1>Bring your <em>people</em></h1>
      <p class="page-header__meta">From Paperless Post, your phone, Google, Outlook or any spreadsheet. You'll see exactly what we found before anything is saved, and nobody is contacted.</p>
    </div>
  </header>
  <div class="switch-steps mt-m">
    <div class="panel"><%= render "dropzone" %></div>
    <%= render "where_to_find" %>
  </div>
</div>
