<%# locals: (event:, design: InvitationDesign.for(event), card_id: "invite-card-#{event.id || 'new'}", show_details: true, editor: false, title_tag: :h1) %>
<%= render "invitations/design_style", design: design, selector: "##{card_id}" %>
<% photo = event.artwork if event.artwork.attached? && event.artwork.blob&.persisted? %>
<% target = ->(name) { editor ? { design_editor_target: name } : {} } %>
<%= tag.article id: card_id, class: [ "invite-card", "invite-card--#{design.layout}" ],
      data: { heading_font: design.heading_font, **target.("card") }, aria: { label: gt("card.aria", title: event.title) } do %>
  <% if design.artwork && lookup_context.exists?(design.artwork, [ "invitation_artworks" ], true) %>
    <%= tag.div class: [ "invite-art", "invite-art--#{design.artwork}" ], aria: { hidden: true }, data: { artwork: design.artwork } do %>
      <%= render "invitation_artworks/#{design.artwork}" %>
    <% end %>
  <% end %>
  <% if photo && design.photo_style == "background" %>
    <figure class="invite-card__photo invite-card__photo--background"><%= image_tag url_for(photo), alt: "" %></figure>
  <% end %>
  <% if event.cancelled? %><div class="invite-card__stamp"><%= gt("card.cancelled") %></div><% end %>
  <div class="invite-card__inner">
    <% if photo && design.photo_style != "background" %>
      <figure class="invite-card__photo invite-card__photo--<%= design.layout == "split" ? "banner" : design.photo_style %>"><%= image_tag url_for(photo), alt: "Invitation artwork" %></figure>
    <% end %>
    <%= tag.p design.tagline, class: "invite-card__tagline", hidden: design.tagline.blank?, data: target.("tagline") %>
    <%= tag.p design.headline, class: "invite-card__headline", hidden: design.headline.blank?, data: target.("headline") %>
    <%= content_tag title_tag, event.title, class: "invite-card__title" %>
    <div class="invite-card__divider" aria-hidden="true"></div>
    <% if show_details %>
      <p class="invite-card__when"><%= card_when(event) %></p>
      <% if (place = event_where(event)).present? %><p class="invite-card__where"><%= place %></p><% end %>
    <% end %>
    <%= tag.p design.message, class: "invite-card__message", hidden: design.message.blank?, data: target.("message") %>
    <p class="invite-card__host"><%= gt("card.hosted_by", host: event.display_host_name) %></p>
  </div>
<% end %>
