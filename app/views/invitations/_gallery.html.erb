<%# locals: (event:) %>
<% photos = event.photos.attachments.select { |a| a.blob&.persisted? } %>
<% if photos.any? %>
  <section class="guest-panel" aria-labelledby="photos-heading">
    <h2 id="photos-heading"><%= gt("card.photos") %></h2>
    <div class="photo-strip">
      <% photos.each_with_index do |photo, i| %>
        <%= link_to url_for(photo), class: "photo-strip__item", target: "_blank", rel: "noopener" do %>
          <%= image_tag url_for(photo), alt: gt("card.photo_alt", n: i + 1, count: photos.size), loading: "lazy" %>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
