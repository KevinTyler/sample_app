<%# locals: (event:, design:, card_id:, envelope_name: nil, envelope_key: nil, private_details: true, schedule: event.schedule_items.select(&:for_everyone?)) %>
<%# The card as guests meet it: sealed in its envelope on the first visit, then flippable to its back. %>
<% content_for :head do %>
  <style nonce="<%= content_security_policy_nonce %>">.guest-body { --guest-backdrop: <%= design.valid? ? design.backdrop_css : "#ebdce1" %>; }</style>
<% end %>
<% content_for :body_class, "guest-body--dark" if design.dark_backdrop? %>
<div class="envelope-stage" data-controller="envelope" data-envelope-key-value="<%= envelope_key %>" data-action="click->envelope#open">
  <%= render "invitations/design_style", design: design, selector: "##{card_id}-envelope" %>
  <div class="card-flip" data-controller="flip">
    <div class="card-flip__inner" data-flip-target="inner">
      <div class="card-flip__face card-flip__face--front" data-flip-target="front">
        <%= render "invitations/card", event: event, design: design, card_id: card_id %>
      </div>
      <div class="card-flip__face card-flip__face--back" data-flip-target="back">
        <%= render "invitations/back", event: event, design: design, card_id: "#{card_id}-back", private_details: private_details, schedule: schedule %>
      </div>
    </div>
    <button type="button" class="flip-button" hidden data-flip-target="button" data-action="flip#toggle" aria-pressed="false">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8"/><path d="M21 3v5h-5"/></svg>
      <span data-flip-target="label">Flip for the details</span>
    </button>
  </div>
  <% if envelope_name %>
    <div class="envelope" id="<%= card_id %>-envelope" data-envelope-target="envelope" data-liner="<%= design.liner %>" data-tone="<%= design.envelope_tone %>" aria-hidden="true">
      <div class="envelope__back"></div>
      <div class="envelope__flap"></div>
      <div class="envelope__front"><%= envelope_stamp(design.stamp) %><span class="envelope__name"><%= envelope_name %></span></div>
    </div>
  <% end %>
</div>
