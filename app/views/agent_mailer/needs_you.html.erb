<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
  <tr><td style="padding:28px 28px 8px;">
    <p style="margin:0 0 6px;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#8A6A2B;">Cordially</p>
    <h1 style="margin:0;font-family:Georgia,'Times New Roman',serif;font-size:28px;line-height:1.2;font-weight:normal;"><%= @proposals.one? ? "This needs you" : "#{@proposals.size} things need you" %>, <%= @user.first_name %></h1>
  </td></tr>
  <% @proposals.each do |proposal| %>
    <tr><td style="padding:10px 28px;">
      <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;background:#FFFDF9;border:1px solid #E4DCCF;border-left:4px solid #8E2B4F;border-radius:12px;">
        <tr><td style="padding:16px 18px;font-size:15px;line-height:1.55;color:#1C1A2E;">
          <strong><%= proposal.title %></strong><br><%= proposal.body %>
        </td></tr>
      </table>
    </td></tr>
  <% end %>
  <tr><td style="padding:16px 28px 28px;">
    <a href="<%= @url %>" style="display:inline-block;background:#15132B;color:#FFFDF9;text-decoration:none;padding:12px 22px;border-radius:999px;font-weight:600;">Review in Cordially</a>
    <p style="margin:18px 0 0;font-size:12px;color:#6F6B82;">Nothing happens until you say so. <a href="<%= edit_account_url(**Messaging.url_options) %>" style="color:#6F6B82;">Change how Cordially reaches you</a>.</p>
  </td></tr>
</table>
