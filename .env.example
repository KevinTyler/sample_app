# Copy to your process manager / hosting provider's environment. None of these are needed for local development.

# Public host used in links inside emails (personal RSVP links, calendar files)
APP_HOST=invites.example.com
# Sender shown on guest emails (display name is set per event: "<Host> via Larkspur")
MAIL_FROM=invitations@example.com

# Email over SMTP (Postmark, SES, SendGrid, Mailgun, ...). Without SMTP_ADDRESS in production,
# deliveries are marked failed with "Email is not configured" instead of being silently dropped.
SMTP_ADDRESS=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain

# SMS (optional). Development defaults to the local outbox; production leaves SMS off unless set.
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567       # or TWILIO_MESSAGING_SERVICE_SID=

# Demo/staging only: capture all mail/SMS at /dev/outbox (protected by HTTP basic auth)
# ENABLE_OUTBOX=1
# OUTBOX_PASSWORD=at-least-12-characters

# Rails
SECRET_KEY_BASE=
RAILS_MAX_THREADS=3

# Bounce/delivery feedback from your email provider (see README: Provider webhooks)
# EMAIL_WEBHOOK_TOKEN=a-long-random-shared-secret
